#!/bin/bash -l
#PBS -N TARP
#PBS -l select=1:ncpus=8:ngpus=1:mem=32gb
#PBS -l walltime=24:00:00
#PBS -m abe
#PBS -j oe

# Load the necessary environment
cd $HOME/Mainframe/tarp

# Tell git to update the project to latest
uv sync

uv run torchrun --nproc-per-node=2 -m tarp.app

echo "Job completed."
